JWT_SECRET=change-me-in-production-this-must-be-at-least-32-chars
# Set to deployed DidRegistry address (for local Hardhat see blockchain/README.md deploy step output).
DID_REGISTRY_ADDRESS=
# Optional: override local Ganache mnemonic for docker-compose blockchain service.
# Never use deterministic mnemonics in production.
GANACHE_MNEMONIC=
# Set funded private key for your local chain account (leave empty until configured).
BLOCKCHAIN_ACCOUNT_PRIVATE_KEY=
