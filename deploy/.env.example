JWT_SECRET=local-demo-jwt-secret-change-before-shared-use-32-plus
JWT_REFRESH_EXPIRATION_MINUTES=10080
AUTH_TOKEN_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_TOKEN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_TOKEN_RATE_LIMIT_MAX_TRACKED_KEYS=10000
IDENTITY_KEY_ROTATION_TOKEN=local-demo-key-rotation-token-change-before-shared-use
# Required for identity-service startup. docker compose will fail until this is set.
# For local Hardhat, use DID_REGISTRY_ADDRESS printed by deploy step in blockchain/README.md.
DID_REGISTRY_ADDRESS=
# Required by docker-compose blockchain service.
# Use a mnemonic dedicated to local demo only.
GANACHE_MNEMONIC=test test test test test test test test test test test junk
# Required for identity-service startup. docker compose will fail until this is set.
# Use a funded key from your local chain (e.g., account key shown in Ganache startup logs).
BLOCKCHAIN_ACCOUNT_PRIVATE_KEY=
